{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User metadata and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "language": { "type": "string", "enum": ["en", "ka"] },
        "theme": { "type": "string", "enum": ["auto", "enterprise", "proton", "light", "vibrant", "midnight", "titanium", "forest", "sunset", "rose"] },
        "themeSchedule": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "dayStart": { "type": "string" },
            "dayEnd": { "type": "string" },
            "dayTheme": { "type": "string" },
            "nightTheme": { "type": "string" }
          }
        },
        "aiSettings": {
          "type": "object",
          "properties": {
            "temperature": { "type": "number", "minimum": 0, "maximum": 1 },
            "enableSearch": { "type": "boolean" },
            "enableMaps": { "type": "boolean" },
            "zenMode": { "type": "boolean" },
            "systemInstruction": { "type": "string" },
            "voice": { "type": "string" },
            "customApiKey": { "type": "string" }
          }
        }
      },
      "required": ["uid", "email"]
    },
    "Workflow": {
      "title": "Workflow",
      "description": "User automation workflows",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "trigger": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "Persona": {
      "title": "Persona",
      "description": "AI Personality settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "avatar": { "type": "string" },
        "systemInstruction": { "type": "string" }
      }
    },
    "Task": {
      "title": "Task",
      "description": "User task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "content": { "type": "string" },
        "completed": { "type": "boolean" },
        "priority": { "type": "string" },
        "projectId": { "type": "string" },
        "category": { "type": "string" }
      }
    },
    "Project": {
      "title": "Project",
      "description": "User project initiative",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "nameGe": { "type": "string" },
        "description": { "type": "string" },
        "descriptionGe": { "type": "string" },
        "color": { "type": "string" },
        "icon": { "type": "string" },
        "targetDate": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "name", "createdAt"]
    },
    "LedgerItem": {
      "title": "Ledger Item",
      "description": "User transaction ledger on the market hub",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "type": { "type": "string", "enum": ["inbound", "outbound"] },
        "value": { "type": "number" },
        "volume": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "completed", "pending"] },
        "operator": { "type": "string" }
      },
      "required": ["id", "description", "category", "type", "value", "volume", "total", "status", "operator"]
    },
    "Listing": {
      "title": "Listing",
      "description": "Marketplace item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "titleGe": { "type": "string" },
        "description": { "type": "string" },
        "descriptionGe": { "type": "string" },
        "price": { "type": "number" },
        "currency": { "type": "string" },
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "category": { "type": "string" },
        "location": { "type": "string" },
        "country": { "type": "string" },
        "city": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "image": { "type": "string" },
        "createdAt": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "title", "price", "sellerId", "category", "country", "city"]
    },
    "Order": {
      "title": "Order",
      "description": "Purchase records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "listingId": { "type": "string" },
        "buyerId": { "type": "string" },
        "sellerId": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "itemTitle": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" }
      }
    },
    "seller_reviews": {
      "title": "Seller Review",
      "description": "Ratings and reviews left by buyers for sellers with verified completed orders",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "listingId": { "type": "string" },
        "sellerId": { "type": "string" },
        "buyerId": { "type": "string" },
        "buyerName": { "type": "string" },
        "rating": { "type": "number" },
        "text": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["orderId", "sellerId", "buyerId", "rating", "text"]
    },
    "SharedSpec": {
      "title": "Shared Spec",
      "description": "Cached AI generated descriptions",
      "type": "object",
      "properties": {
        "spec": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "createdAt": { "type": "number" }
      }
    },
    "Clip": {
      "title": "Proton Reel Clip",
      "description": "Short vertical video post shared by general users or marketplace sellers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "videoUrl": { "type": "string" },
        "caption": { "type": "string" },
        "creatorId": { "type": "string" },
        "creatorName": { "type": "string" },
        "creatorAvatar": { "type": "string" },
        "likes": { "type": "array" },
        "likesCount": { "type": "number" },
        "soundName": { "type": "string" },
        "productId": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "videoUrl", "caption", "creatorId", "creatorName", "createdAt"]
    },
    "ClipComment": {
      "title": "Clip Comment",
      "description": "User comments on video clips",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clipId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "clipId", "userId", "userName", "text", "createdAt"]
    },
    "ListingAnalytics": {
      "title": "Listing Analytics",
      "description": "Server-managed private analytics counters and rolling buckets for a listing",
      "type": "object",
      "properties": {
        "listingId": { "type": "string" },
        "sellerId": { "type": "string" },
        "category": { "type": "string" },
        "listingType": { "type": "string", "enum": ["product", "service", "project"] },
        "impressions": { "type": "number" },
        "views": { "type": "number" },
        "uniqueViewers": { "type": "number" },
        "authImpressions": { "type": "number" },
        "authViews": { "type": "number" },
        "authUniqueViewers": { "type": "number" },
        "guestImpressions": { "type": "number" },
        "guestViews": { "type": "number" },
        "guestUniqueViewers": { "type": "number" },
        "breakdownSince": { "type": "number" },
        "optedOut": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["listingId", "sellerId", "impressions", "views", "uniqueViewers"]
    },
    "ListingViewerMarker": {
      "title": "Listing Viewer Marker",
      "description": "Server-only salted viewer hash deduplication marker (zero PII/IP)",
      "type": "object",
      "properties": {
        "viewerHash": { "type": "string" },
        "viewerType": { "type": "string", "enum": ["auth", "guest"] },
        "firstImpressionAt": { "type": "number" },
        "lastImpressionAt": { "type": "number" },
        "firstViewedAt": { "type": "number" },
        "lastViewAt": { "type": "number" }
      },
      "required": ["viewerHash", "viewerType"]
    },
    "ListingAnalyticsPublic": {
      "title": "Listing Analytics Public Projection",
      "description": "Public aggregated stats for opted-in active listings used in rankings (zero PII)",
      "type": "object",
      "properties": {
        "listingId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "listingType": { "type": "string", "enum": ["product", "service", "project"] },
        "sellerName": { "type": "string" },
        "country": { "type": "string" },
        "region": { "type": "string" },
        "impressions": { "type": "number" },
        "views": { "type": "number" },
        "uniqueViewers": { "type": "number" },
        "authImpressions": { "type": "number" },
        "authViews": { "type": "number" },
        "authUniqueViewers": { "type": "number" },
        "guestImpressions": { "type": "number" },
        "guestViews": { "type": "number" },
        "guestUniqueViewers": { "type": "number" },
        "breakdownSince": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["listingId", "category", "impressions", "views", "uniqueViewers"]
    },
    "SellerCompetitionPreference": {
      "title": "Seller Competition Preference",
      "description": "Opt-out control for public Healthy Competition rankings",
      "type": "object",
      "properties": {
        "optedOut": { "type": "boolean" },
        "updatedAt": { "type": "number" }
      },
      "required": ["optedOut", "updatedAt"]
    },
    "SellerAnalytics": {
      "title": "Seller Analytics",
      "description": "Server-managed private seller audience, funnel metrics, and rolling buckets (no fabricated history)",
      "type": "object",
      "properties": {
        "sellerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "metadata": {
          "type": "object",
          "properties": {
            "schemaVersion": { "type": "number" },
            "sellerName": { "type": "string", "maxLength": 200 },
            "lastEventAt": { "type": "number" }
          }
        },
        "optedOut": { "type": "boolean" },
        "country": { "type": "string", "maxLength": 64 },
        "region": { "type": "string", "maxLength": 64 },
        "funnelTrackingSince": { "type": "number" },
        "audience": {
          "type": "object",
          "properties": {
            "totalImpressions": { "type": "number" },
            "totalViews": { "type": "number" },
            "uniqueViewers": { "type": "number" },
            "authImpressions": { "type": "number" },
            "authViews": { "type": "number" },
            "authUniqueViewers": { "type": "number" },
            "guestImpressions": { "type": "number" },
            "guestViews": { "type": "number" },
            "guestUniqueViewers": { "type": "number" }
          }
        },
        "totals": {
          "type": "object",
          "properties": {
            "totalEvents": { "type": "number" },
            "totalUniqueUsers": { "type": "number" },
            "authEvents": { "type": "number" },
            "guestEvents": { "type": "number" },
            "authUniqueUsers": { "type": "number" },
            "guestUniqueUsers": { "type": "number" }
          }
        },
        "profileViews": { "type": "number" },
        "uniqueProfileViewers": { "type": "number" },
        "authProfileViews": { "type": "number" },
        "guestProfileViews": { "type": "number" },
        "authUniqueProfileViewers": { "type": "number" },
        "guestUniqueProfileViewers": { "type": "number" },
        "listingToSellerClicks": { "type": "number" },
        "uniqueListingToSellerUsers": { "type": "number" },
        "authListingToSellerClicks": { "type": "number" },
        "guestListingToSellerClicks": { "type": "number" },
        "authUniqueListingToSellerUsers": { "type": "number" },
        "guestUniqueListingToSellerUsers": { "type": "number" },
        "contactClicks": { "type": "number" },
        "uniqueContactClickers": { "type": "number" },
        "authContactClicks": { "type": "number" },
        "guestContactClicks": { "type": "number" },
        "authUniqueContactClickers": { "type": "number" },
        "guestUniqueContactClickers": { "type": "number" },
        "orderIntents": { "type": "number" },
        "uniqueOrderIntentUsers": { "type": "number" },
        "authOrderIntents": { "type": "number" },
        "guestOrderIntents": { "type": "number" },
        "authUniqueOrderIntentUsers": { "type": "number" },
        "guestUniqueOrderIntentUsers": { "type": "number" },
        "contactConfirmed": { "type": "number" },
        "uniqueContactedBuyers": { "type": "number" },
        "ordersConfirmed": { "type": "number" },
        "uniqueOrderBuyers": { "type": "number" },
        "guestToAuthLinks": { "type": "number" },
        "hourly": { "type": "object" },
        "daily": { "type": "object" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["sellerId", "optedOut", "funnelTrackingSince", "createdAt", "updatedAt"]
    },
    "SellerViewerMarker": {
      "title": "Seller Viewer Marker",
      "description": "Server-only seller-scoped HMAC viewer hash marker (zero raw IP, visitorToken, User-Agent, UID, or PII)",
      "type": "object",
      "properties": {
        "viewerHash": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
        "viewerType": { "type": "string", "enum": ["auth", "guest"] },
        "firstSeenAt": { "type": "number" },
        "lastSeenAt": { "type": "number" },
        "firstProfileViewAt": { "type": "number" },
        "lastProfileViewAt": { "type": "number" },
        "firstListingToSellerAt": { "type": "number" },
        "lastListingToSellerAt": { "type": "number" },
        "firstContactClickAt": { "type": "number" },
        "lastContactClickAt": { "type": "number" },
        "firstOrderIntentAt": { "type": "number" },
        "lastOrderIntentAt": { "type": "number" },
        "firstContactConfirmedAt": { "type": "number" },
        "firstOrderConfirmedAt": { "type": "number" },
        "firstAudienceAt": { "type": "number" },
        "lastAudienceAt": { "type": "number" }
      },
      "required": ["viewerHash", "viewerType", "firstSeenAt", "lastSeenAt"]
    },
    "AnalyticsGuestSession": {
      "title": "Analytics Guest Session",
      "description": "Server-only HMAC guest session index for atomic single-claim guest-to-auth identity linking (30-day TTL)",
      "type": "object",
      "properties": {
        "guestHash": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
        "listingIds": { "type": "array", "description": "Bounded unique listing IDs (max 50)" },
        "sellerIds": { "type": "array", "description": "Bounded unique seller IDs (max 30)" },
        "linkedUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "linkedAt": { "type": "number" },
        "expiresAt": { "type": "number" }
      },
      "required": ["guestHash", "listingIds", "sellerIds", "createdAt", "updatedAt", "expiresAt"]
    },
    "AnalyticsVerifiedMarker": {
      "title": "Analytics Verified Marker",
      "description": "Server-only idempotency marker preventing duplicate counting of confirmed orders and buyer-seller contacts",
      "type": "object",
      "properties": {
        "markerId": { "type": "string", "maxLength": 128, "pattern": "^(order|contact)_[a-zA-Z0-9_\\-]+$" },
        "markerType": { "type": "string", "enum": ["contact_confirmed", "order_confirmed"] },
        "sellerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "buyerHash": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
        "sourceId": { "type": "string", "maxLength": 120, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "listingId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "recordedAt": { "type": "number" }
      },
      "required": ["markerId", "markerType", "sellerId", "buyerHash", "sourceId", "recordedAt"]
    }
  },
  "firestore": {
    "/clips/{clipId}": {
      "schema": "Clip",
      "description": "Global user-generated video reels / TikTok-style platform clips"
    },
    "/clips/{clipId}/comments/{commentId}": {
      "schema": "ClipComment",
      "description": "Subcollection of comments left on a specific video clip"
    },
    "/shared_specs/{specId}": {
      "schema": "SharedSpec",
      "description": "Global cache for AI specs"
    },
    "/listings/{listingId}": {
      "schema": "Listing",
      "description": "Global marketplace listings"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Global purchase records"
    },
    "/seller_reviews/{reviewId}": {
      "schema": "seller_reviews",
      "description": "Ratings and comments left for sellers by purchasers"
    },
    "/market_messages/{messageId}": {
      "schema": "object",
      "description": "Direct message chat between buyers and sellers"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Main user document"
    },
    "/users/{userId}/usage/{usageId}": {
      "schema": "object",
      "description": "User usage tracking (rate limits)"
    },
    "/users/{userId}/workflows/{workflowId}": {
      "schema": "Workflow",
      "description": "User workflows"
    },
    "/users/{userId}/personas/{personaId}": {
      "schema": "Persona",
      "description": "User personas"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "User tasks"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": "Project",
      "description": "User projects"
    },
    "/users/{userId}/market_ledger/{ledgerId}": {
      "schema": "LedgerItem",
      "description": "User market ledger transactions"
    },
    "/users/{userId}/chatHistory/{personaId}": {
      "schema": "object",
      "description": "Chat messages with a persona"
    },
    "/listing_analytics/{listingId}": {
      "schema": "ListingAnalytics",
      "description": "Private server-maintained analytics counters per listing (owner read-only)"
    },
    "/listing_analytics/{listingId}/viewers/{viewerHash}": {
      "schema": "ListingViewerMarker",
      "description": "Server-only salted hash markers for unique viewer deduplication and cooldowns"
    },
    "/listing_analytics_public/{listingId}": {
      "schema": "ListingAnalyticsPublic",
      "description": "Aggregated public ranking metrics for opted-in active listings"
    },
    "/seller_competition_prefs/{userId}": {
      "schema": "SellerCompetitionPreference",
      "description": "Seller opt-out preference for public rankings"
    },
    "/seller_analytics/{sellerId}": {
      "schema": "SellerAnalytics",
      "description": "Private aggregated seller analytics and funnel metrics (owner get-only, server Admin SDK writes only)"
    },
    "/seller_analytics/{sellerId}/viewers/{sellerViewerHash}": {
      "schema": "SellerViewerMarker",
      "description": "Server-only seller-scoped HMAC viewer markers (zero client read/write)"
    },
    "/analytics_guest_sessions/{guestHash}": {
      "schema": "AnalyticsGuestSession",
      "description": "Server-only guest session index with 30-day TTL and atomic single-claim state (zero client read/write)"
    },
    "/analytics_verified_markers/{markerId}": {
      "schema": "AnalyticsVerifiedMarker",
      "description": "Server-only verified funnel idempotency markers for orders and contacts (zero client read/write)"
    }
  }
}
