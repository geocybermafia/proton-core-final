rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ======================================================
    // 0. GLOBAL SAFETY NET (DEFAULT DENY ALL)
    // ======================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ======================================================
    // HELPER PRIMITIVES
    // ======================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Safely get string property or default
    function getStr(data, key, defVal) {
      return (key in data && data[key] is string) ? data[key] : defVal;
    }

    // Safely get number property or default
    function getNum(data, key, defVal) {
      return (key in data && data[key] is number) ? data[key] : defVal;
    }

    // Authoritative listing type helpers
    function isServiceOrProjectListing(data) {
      return getStr(data, 'listingType', '') in ['service', 'project']
        || getStr(data, 'category', '') in ['service', 'project'];
    }

    function isDigitalListing(data) {
      return getStr(data, 'listingType', '') == 'digital'
        || getStr(data, 'category', '') == 'digital';
    }

    function isPhysicalListing(data) {
      return !isServiceOrProjectListing(data) && !isDigitalListing(data);
    }

    // ======================================================
    // ZERO-TRUST SECURITY GUARDS
    // ======================================================
    
    // Privilege Escalation Guard: Prevent users from claiming 'admin' on creation
    function isNotRoleEscalated() {
      return !('role' in incoming()) || incoming().role != 'admin';
    }

    // Privilege Escalation Guard: Deny any update that touches the 'role' field
    function isRoleUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
    }

    // Cryptographic PIN metadata validation
    function isValidSecurityPinMeta(meta) {
      return meta is map
        && (!('enabled' in meta) || meta.enabled is bool)
        && (!('salt' in meta) || (meta.salt is string && meta.salt.size() <= 64))
        && (!('verifier' in meta) || (meta.verifier is string && meta.verifier.size() <= 128))
        && (!('version' in meta) || meta.version is number)
        && (!('updatedAt' in meta) || meta.updatedAt is number);
    }

    function isSafeUserCreate() {
      return isNotRoleEscalated()
        && (!('securityPinMeta' in incoming()) || incoming().securityPinMeta == null || isValidSecurityPinMeta(incoming().securityPinMeta));
    }

    function isSafeUserUpdate() {
      return isRoleUnchanged()
        && (!('securityPinMeta' in incoming()) || incoming().securityPinMeta == null || isValidSecurityPinMeta(incoming().securityPinMeta));
    }

    // ======================================================
    // ENTITY VALIDATORS
    // ======================================================
    
    function isValidListingShape(data) {
      return getStr(data, 'title', '').size() <= 200
        && getNum(data, 'price', 0) > 0
        && getStr(data, 'category', '').size() <= 50
        && getStr(data, 'country', '').size() <= 50
        && getStr(data, 'city', '').size() <= 50
        && (getStr(data, 'status', 'active') in ['active', 'sold'])
        && getStr(data, 'description', '').size() <= 5000
        && getStr(data, 'image', '').size() <= 2000000;
    }

    function isValidListingCreate(data) {
      return data.keys().hasAll(['title', 'price', 'sellerId', 'category', 'country', 'city', 'createdAt', 'status'])
        && data.keys().size() >= 8 && data.keys().size() <= 32
        && data.sellerId == request.auth.uid
        && data.createdAt == request.time
        && isValidListingShape(data);
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['listingId', 'buyerId', 'sellerId', 'amount', 'currency', 'itemTitle', 'status', 'createdAt'])
        && data.keys().size() >= 8 && data.keys().size() <= 16
        && data.buyerId == request.auth.uid
        && data.buyerId != data.sellerId
        && data.listingId is string && data.listingId.size() <= 128
        && data.sellerId is string && data.sellerId.size() <= 128
        && data.amount is number && data.amount >= 0
        && data.currency is string && data.currency.size() <= 10
        && data.itemTitle is string && data.itemTitle.size() <= 200
        && data.status is string && data.status in ['pending', 'booked', 'completed']
        && data.createdAt == request.time
        && (!('shippingDetails' in data) || (
          data.shippingDetails is map
          && data.shippingDetails.keys().hasAll(['phone', 'city', 'address'])
          && data.shippingDetails.phone is string && data.shippingDetails.phone.size() <= 50
          && data.shippingDetails.city is string && data.shippingDetails.city.size() <= 100
          && data.shippingDetails.address is string && data.shippingDetails.address.size() <= 500
        ));
    }

    // ======================================================
    // 1. PROFILES & USERS
    // ======================================================
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isSafeUserCreate();
      allow update: if isOwner(userId) && isSafeUserUpdate();
      allow delete: if false;

      match /workflows/{id} {
        allow read, write: if isOwner(userId);
      }
      match /personas/{id} {
        allow read, write: if isOwner(userId);
      }
      match /chatHistory/{id} {
        allow read, write: if isOwner(userId);
      }
      match /tasks/{id} {
        allow read, write: if isOwner(userId);
      }
      match /projects/{id} {
        allow read, write: if isOwner(userId);
      }
      // FINANCIAL LOGS: Read-only for owner. Client-side writes blocked.
      match /market_ledger/{id} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      match /customAvatars/{id} {
        allow read, write: if isOwner(userId);
      }
      match /stats/{id} {
        allow read, write: if isOwner(userId);
      }
      match /usage/{id} {
        allow read, write: if isOwner(userId);
      }
      match /notifications/{id} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && request.resource.data.keys().hasAll(['title', 'message', 'timestamp', 'read', 'category']);
      }
      // Server-only security state (lockout counter, step-up grants)
      match /security/{docId} {
        allow read, write: if false; // Admin SDK only
      }
    }

    match /profiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /test/connection {
      allow get: if isSignedIn();
    }

    // ======================================================
    // 2. FINANCIAL TRANSACTIONS & MARKET LEDGER
    // ======================================================
    match /market_ledger/{transactionId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid
      );
      allow write: if false; // Read-only from frontend
    }

    // ======================================================
    // 3. LISTINGS
    // ======================================================
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isVerified() && isValidId(listingId) && isValidListingCreate(incoming());
      allow update: if isVerified() && isValidId(listingId)
        && incoming().createdAt == existing().createdAt
        && (
          (isOwner(existing().sellerId) && isValidListingShape(incoming()) && incoming().sellerId == existing().sellerId && !(existing().status == 'sold' && incoming().status == 'active')) ||
          (isOwner(existing().sellerId) && incoming().diff(existing()).affectedKeys().hasOnly(['status']) && !(existing().status == 'sold' && incoming().status == 'active')) ||
          // Legitimate buyer purchase transition with atomic order link:
          // Must be transitioning from active to sold, modifying status, isSold and activeOrderId atomically linked to order creation
          (
            existing().status == 'active' &&
            incoming().status == 'sold' &&
            incoming().sellerId == existing().sellerId &&
            incoming().price == existing().price &&
            incoming().createdAt == existing().createdAt &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'isSold', 'activeOrderId']) &&
            (
              !('activeOrderId' in incoming()) ||
              (
                incoming().activeOrderId is string &&
                isValidId(incoming().activeOrderId) &&
                existsAfter(/databases/$(database)/documents/orders/$(incoming().activeOrderId)) &&
                getAfter(/databases/$(database)/documents/orders/$(incoming().activeOrderId)).data.listingId == listingId &&
                getAfter(/databases/$(database)/documents/orders/$(incoming().activeOrderId)).data.buyerId == request.auth.uid &&
                getAfter(/databases/$(database)/documents/orders/$(incoming().activeOrderId)).data.sellerId == existing().sellerId &&
                getAfter(/databases/$(database)/documents/orders/$(incoming().activeOrderId)).data.amount == existing().price &&
                getAfter(/databases/$(database)/documents/orders/$(incoming().activeOrderId)).data.status in ['pending', 'completed'] &&
                getAfter(/databases/$(database)/documents/orders/$(incoming().activeOrderId)).data.orderType == 'product'
              )
            )
          ) ||
          // Legitimate order cancellation restoration:
          // Transitioning from sold to active when the associated pending/booked order is cancelled
          (
            existing().status == 'sold' &&
            incoming().status == 'active' &&
            incoming().sellerId == existing().sellerId &&
            incoming().price == existing().price &&
            incoming().createdAt == existing().createdAt &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'isSold', 'activeOrderId']) &&
            (
              (
                (!('activeOrderId' in existing()) || existing().activeOrderId == null) &&
                request.auth.uid == existing().sellerId
              ) ||
              (
                'activeOrderId' in existing() &&
                existing().activeOrderId is string &&
                isValidId(existing().activeOrderId) &&
                existsAfter(/databases/$(database)/documents/orders/$(existing().activeOrderId)) &&
                getAfter(/databases/$(database)/documents/orders/$(existing().activeOrderId)).data.listingId == listingId &&
                (request.auth.uid == existing().sellerId || request.auth.uid == getAfter(/databases/$(database)/documents/orders/$(existing().activeOrderId)).data.buyerId) &&
                getAfter(/databases/$(database)/documents/orders/$(existing().activeOrderId)).data.status == 'cancelled'
              )
            )
          )
        );
      allow delete: if isVerified() && isValidId(listingId) && isOwner(existing().sellerId);
    }

    // ======================================================
    // 4. ORDERS
    // ======================================================
    match /orders/{orderId} {
      allow list: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      allow get: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      
      allow create: if isVerified() && isValidId(orderId) && isValidOrder(incoming())
        && exists(/databases/$(database)/documents/listings/$(incoming().listingId))
        && get(/databases/$(database)/documents/listings/$(incoming().listingId)).data.status == 'active'
        && incoming().amount == get(/databases/$(database)/documents/listings/$(incoming().listingId)).data.price
        && incoming().sellerId == get(/databases/$(database)/documents/listings/$(incoming().listingId)).data.sellerId
        && (
          // 1. Service or Project listings MUST start as 'booked' (cannot be 'pending' or 'completed')
          (
            isServiceOrProjectListing(get(/databases/$(database)/documents/listings/$(incoming().listingId)).data)
            && incoming().status == 'booked'
          )
          ||
          // 2. Physical product listings MUST start as 'pending' (cannot be 'booked' or 'completed')
          (
            isPhysicalListing(get(/databases/$(database)/documents/listings/$(incoming().listingId)).data)
            && incoming().status == 'pending'
          )
          ||
          // 3. Digital product listings can start as 'completed' ONLY IF explicitly digital
          // AND the listing is atomically transitioned to 'sold' referencing this activeOrderId
          (
            isDigitalListing(get(/databases/$(database)/documents/listings/$(incoming().listingId)).data)
            && incoming().status == 'completed'
            && existsAfter(/databases/$(database)/documents/listings/$(incoming().listingId))
            && getAfter(/databases/$(database)/documents/listings/$(incoming().listingId)).data.status == 'sold'
            && getAfter(/databases/$(database)/documents/listings/$(incoming().listingId)).data.activeOrderId == orderId
          )
        );
        
      allow update: if isVerified() && (existing().buyerId == request.auth.uid || existing().sellerId == request.auth.uid)
        && incoming().buyerId == existing().buyerId
        && incoming().sellerId == existing().sellerId
        && incoming().listingId == existing().listingId
        && incoming().amount == existing().amount
        && incoming().currency == existing().currency
        && incoming().itemTitle == existing().itemTitle
        && incoming().createdAt == existing().createdAt
        && (
          (!('shippingDetails' in existing()) && !('shippingDetails' in incoming()))
          || (incoming().shippingDetails == existing().shippingDetails)
        )
        && (
          (
            isOwner(existing().sellerId)
            && (
              (existing().status == 'pending' && incoming().status == 'processing' && incoming().diff(existing()).affectedKeys().hasOnly(['status']))
              ||
              (
                existing().status == 'processing' 
                && incoming().status == 'shipped' 
                && (
                  (incoming().diff(existing()).affectedKeys().hasOnly(['status']))
                  ||
                  (
                    incoming().diff(existing()).affectedKeys().hasOnly(['status', 'trackingInfo'])
                    && incoming().trackingInfo is map
                    && incoming().trackingInfo.keys().hasAll(['carrier', 'trackingNumber'])
                    && incoming().trackingInfo.carrier is string && incoming().trackingInfo.carrier.size() <= 100
                    && incoming().trackingInfo.trackingNumber is string && incoming().trackingInfo.trackingNumber.size() <= 100
                  )
                )
              )
              ||
              (existing().status == 'booked' && incoming().status == 'in_progress' && incoming().diff(existing()).affectedKeys().hasOnly(['status']))
              ||
              (existing().status == 'in_progress' && incoming().status == 'completed' && incoming().diff(existing()).affectedKeys().hasOnly(['status']))
              ||
              (existing().status in ['pending', 'booked'] && incoming().status in ['cancelled', 'refunded'] && incoming().diff(existing()).affectedKeys().hasOnly(['status']))
            )
          )
          ||
          (
            isOwner(existing().buyerId)
            && (
              (existing().status == 'shipped' && incoming().status == 'completed' && incoming().diff(existing()).affectedKeys().hasOnly(['status']))
              ||
              (existing().status in ['pending', 'booked'] && incoming().status == 'cancelled' && incoming().diff(existing()).affectedKeys().hasOnly(['status']))
            )
          )
        );
      allow delete: if false;
    }

    // ======================================================
    // 5. SELLER REVIEWS & RATINGS
    // ======================================================
    function isValidReview(data) {
      return data.keys().hasAll(['orderId', 'buyerId', 'sellerId', 'rating', 'text', 'createdAt'])
        && data.keys().size() >= 6 && data.keys().size() <= 10
        && data.orderId is string && isValidId(data.orderId)
        && data.buyerId is string && isValidId(data.buyerId)
        && data.sellerId is string && isValidId(data.sellerId)
        && data.buyerId == request.auth.uid
        && data.sellerId != request.auth.uid
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.text is string && data.text.size() <= 2000
        && (!('listingId' in data) || (data.listingId is string && isValidId(data.listingId)))
        && (!('buyerName' in data) || (data.buyerName is string && data.buyerName.size() <= 100));
    }

    match /seller_reviews/{reviewId} {
      allow read: if true;
      allow create: if isVerified() && isValidId(reviewId) 
        && reviewId == 'rev_' + incoming().orderId
        && isValidReview(incoming())
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/orders/$(incoming().orderId))
        && get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.buyerId == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.sellerId == incoming().sellerId
        && get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.status == 'completed'
        && (!('listingId' in incoming()) || incoming().listingId == get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.listingId);

      allow update: if isVerified() && isValidId(reviewId) 
        && existing().buyerId == request.auth.uid 
        && incoming().buyerId == existing().buyerId 
        && incoming().sellerId == existing().sellerId 
        && (!('orderId' in existing()) || incoming().orderId == existing().orderId)
        && (!('listingId' in existing()) || incoming().listingId == existing().listingId)
        && incoming().createdAt == existing().createdAt
        && incoming().rating is number 
        && incoming().rating >= 1 && incoming().rating <= 5 
        && incoming().text is string && incoming().text.size() <= 2000
        && (!('buyerName' in incoming()) || (incoming().buyerName is string && incoming().buyerName.size() <= 100));

      allow delete: if isVerified() && isValidId(reviewId) 
        && existing().buyerId == request.auth.uid;
    }

    // ======================================================
    // 6. CHAT MESSAGES BETWEEN TRADERS
    // ======================================================
    match /market_messages/{messageId} {
      allow read, list: if isSignedIn() && (
        ('participants' in resource.data && request.auth.uid in resource.data.participants) ||
        getStr(resource.data, 'senderId', '') == request.auth.uid || 
        getStr(resource.data, 'receiverId', '') == request.auth.uid
      );
      allow create: if isVerified() && isValidId(messageId) 
        && incoming().senderId == request.auth.uid
        && incoming().participants is list
        && incoming().participants.size() == 2
        && request.auth.uid in incoming().participants
        && incoming().buyerId is string && isValidId(incoming().buyerId)
        && incoming().sellerId is string && isValidId(incoming().sellerId)
        && incoming().listingId is string && isValidId(incoming().listingId)
        && incoming().participants.hasAll([incoming().buyerId, incoming().sellerId])
        && incoming().conversationId is string
        && incoming().conversationId == incoming().listingId + '_' + incoming().buyerId
        && incoming().receiverId == (request.auth.uid == incoming().sellerId ? incoming().buyerId : incoming().sellerId)
        && incoming().text is string && incoming().text.size() > 0 && incoming().text.size() <= 2000
        && incoming().listingTitle is string && incoming().listingTitle.size() <= 300
        && (!('orderId' in incoming()) || (incoming().orderId is string && isValidId(incoming().orderId)))
        && (!('senderAvatar' in incoming()) || (incoming().senderAvatar is string && incoming().senderAvatar.size() <= 2000))
        && (!('senderName' in incoming()) || (incoming().senderName is string && incoming().senderName.size() <= 200));
      allow update, delete: if false;
    }

    // ======================================================
    // 7. SYSTEM
    // ======================================================
    match /system/config {
      allow read: if true;
      allow write: if false;
    }

    // ======================================================
    // 8. AI OPTIMIZATION
    // ======================================================
    match /shared_specs/{specId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() 
        && incoming().spec is string && incoming().spec.size() <= 2000
        && incoming().createdAt == request.time;
    }

    // ======================================================
    // 9. PROTON CLIPS
    // ======================================================
    match /clips/{clipId} {
      allow read: if true;
      allow create: if isVerified() && isValidId(clipId) 
        && incoming().creatorId == request.auth.uid
        && incoming().videoUrl is string && incoming().videoUrl.size() <= 2000
        && incoming().caption is string && incoming().caption.size() <= 500
        && incoming().creatorName is string && incoming().creatorName.size() <= 200
        && incoming().createdAt == request.time;
      allow update: if isVerified() && isValidId(clipId) && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'likesCount']) 
          && incoming().likes is list && incoming().likes.size() <= 100000
          && (incoming().likesCount is number || incoming().likesCount is int)) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount'])
          && (incoming().commentsCount is number || incoming().commentsCount is int)) ||
        (existing().creatorId == request.auth.uid 
          && incoming().creatorId == request.auth.uid 
          && incoming().videoUrl == existing().videoUrl
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['caption', 'soundName', 'productId', 'productInfo', 'trimStart', 'trimEnd']))
      );
      allow delete: if isVerified() && isValidId(clipId) && existing().creatorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isVerified() && isValidId(commentId)
          && incoming().userId == request.auth.uid
          && incoming().clipId == clipId
          && incoming().text is string && incoming().text.size() <= 1000
          && (incoming().createdAt == request.time || incoming().createdAt is string || incoming().createdAt is timestamp);
        allow delete: if isVerified() && isValidId(commentId) 
          && (existing().userId == request.auth.uid || get(/databases/$(database)/documents/clips/$(clipId)).data.creatorId == request.auth.uid);
      }
    }
  }
}
