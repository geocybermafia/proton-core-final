rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ======================================================
    // 0. GLOBAL SAFETY NET
    // ======================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ======================================================
    // PHASE 3: PRIMITIVES
    // ======================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      // In many production apps, email verification is required.
      // Keeping it commented or optional based on app context.
      // return isSignedIn() && request.auth.token.email_verified == true;
      return isSignedIn();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ======================================================
    // ENTITY VALIDATORS (PILLAR 2)
    // ======================================================
    
    function isValidListingShape(data) {
      return (data.get('title', '') is string && data.get('title', '').size() <= 200)
        && (data.get('price', 0) is number && data.get('price', 0) >= 0)
        && (data.get('category', '') is string && data.get('category', '').size() <= 50)
        && (data.get('country', '') is string && data.get('country', '').size() <= 50)
        && (data.get('city', '') is string && data.get('city', '').size() <= 50)
        && (data.get('status', 'active') in ['active', 'sold'])
        && (data.get('description', '') is string && data.get('description', '').size() <= 5000)
        && (data.get('image', '') is string && data.get('image', '').size() <= 2000000); // Allow up to 2MB for base64
    }

    function isValidListingCreate(data) {
      return data.keys().hasAll(['title', 'price', 'sellerId', 'category', 'country', 'city', 'createdAt', 'status'])
        && data.keys().size() >= 8 && data.keys().size() <= 32
        && data.sellerId == request.auth.uid
        && data.createdAt == request.time
        && isValidListingShape(data);
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['listingId', 'buyerId', 'sellerId', 'amount', 'currency', 'itemTitle', 'status', 'createdAt'])
        && data.keys().size() >= 8 && data.keys().size() <= 10
        && data.buyerId == request.auth.uid
        && data.listingId is string && data.listingId.size() <= 128
        && data.sellerId is string && data.sellerId.size() <= 128
        && data.amount is number && data.amount >= 0
        && data.currency is string && data.currency.size() <= 10
        && data.itemTitle is string && data.itemTitle.size() <= 200
        && data.status is string && data.status.size() <= 50
        && data.createdAt == request.time;
    }

    function isValidStatsShape(data) {
      return data.get('dailyGenerationsCount', 0) is number
        && data.get('dailyGenerationsCount', 0) >= 0
        && data.get('dailyGenerationsCount', 0) <= 25
        && data.get('dailyGenerationsDate', '') is string
        && data.get('aiTokens', 0) is number
        && data.get('aiTokens', 0) >= 0
        && data.get('computeTimeHours', 0) is number
        && data.get('computeTimeHours', 0) >= 0
        && data.get('storageGB', 0) is number
        && data.get('storageGB', 0) >= 0
        && data.get('spendingLimit', 0) is number
        && data.get('spendingLimit', 0) >= 0;
    }

    function isValidStatsCreate(data) {
      return isValidStatsShape(data)
        && data.get('dailyGenerationsCount', 0) <= 20
        && data.get('aiTokens', 0) <= 10000;
    }

    function isValidStatsUpdate(incoming, existing) {
      return isValidStatsShape(incoming)
        // 1. Quota Tampering Protection:
        // Same date: dailyGenerationsCount must not decrease (prevents resetting count back to 0 on same date)
        // New date: dailyGenerationsCount must reset to <= 1
        && (
          (incoming.get('dailyGenerationsDate', '') == existing.get('dailyGenerationsDate', '')
            && incoming.get('dailyGenerationsCount', 0) >= existing.get('dailyGenerationsCount', 0))
          ||
          (incoming.get('dailyGenerationsDate', '') != existing.get('dailyGenerationsDate', '')
            && incoming.get('dailyGenerationsCount', 0) <= 1)
        )
        // 2. Token & Compute Counter Protection:
        // aiTokens and computeTimeHours can only increase or stay same, never arbitrarily decrease/reset
        && incoming.get('aiTokens', 0) >= existing.get('aiTokens', 0)
        && incoming.get('computeTimeHours', 0) >= existing.get('computeTimeHours', 0);
    }

    // ======================================================
    // 1. PROFILES & USERS
    // ======================================================
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        && incoming().get('ai_tokens', 0) >= existing().get('ai_tokens', 0)
        && incoming().get('aiTokens', 0) >= existing().get('aiTokens', 0);
      
      match /workflows/{id} {
        allow read, write: if isOwner(userId);
      }
      match /personas/{id} {
        allow read, write: if isOwner(userId);
      }
      match /chatHistory/{id} {
        allow read, write: if isOwner(userId);
      }
      match /tasks/{id} {
        allow read, write: if isOwner(userId);
      }
      match /market_ledger/{id} {
        allow read, write: if isOwner(userId);
      }
      match /customAvatars/{id} {
        allow read, write: if isOwner(userId);
      }
      match /stats/{id} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidStatsCreate(incoming());
        allow update: if isOwner(userId) && isValidStatsUpdate(incoming(), existing());
        allow delete: if false;
      }
    }

    match /profiles/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        && incoming().get('ai_tokens', 0) >= existing().get('ai_tokens', 0);
    }

    match /test/connection {
      allow get: if isSignedIn();
    }

    // ======================================================
    // 2. LISTINGS (PILLAR 3 & 8)
    // ======================================================
    match /listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidId(listingId) && isValidListingCreate(incoming());
      allow update: if isVerified() && isValidId(listingId) && (
        // Action: Edit by owner
        (isOwner(existing().sellerId) && isValidListingShape(incoming()) && incoming().sellerId == existing().sellerId) ||
        // Action: Mark as sold
        (isOwner(existing().sellerId) && incoming().diff(existing()).affectedKeys().hasOnly(['status'])) ||
        // Action: Self-healing / Claim restored listings globally
        (existing().sellerId == "rCWg6xJA2rfnnEWMbOFQdMJljxD3" && incoming().sellerId == request.auth.uid && isValidListingShape(incoming()))
      );
      allow delete: if isVerified() && isValidId(listingId) && isOwner(existing().sellerId);
    }

    // ======================================================
    // 3. ORDERS (NEW - PILLAR 8)
    // ======================================================
    match /orders/{orderId} {
      // Secure List Queries (Pillar 8)
      // Users can only see orders they bought or sold
      allow list: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      allow get: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      
      allow create: if isVerified() && isValidId(orderId) && isValidOrder(incoming())
        // Relational Sync & Price Validation
        && exists(/databases/$(database)/documents/listings/$(incoming().listingId))
        && incoming().amount == get(/databases/$(database)/documents/listings/$(incoming().listingId)).data.price
        && incoming().sellerId == get(/databases/$(database)/documents/listings/$(incoming().listingId)).data.sellerId;
        
      allow update: if isVerified() && (existing().buyerId == request.auth.uid || existing().sellerId == request.auth.uid)
        && incoming().buyerId == existing().buyerId
        && incoming().sellerId == existing().sellerId
        && incoming().listingId == existing().listingId
        && incoming().amount == existing().amount
        && incoming().currency == existing().currency
        && incoming().itemTitle == existing().itemTitle
        && incoming().createdAt == existing().createdAt
        // Role-Based Status Update Authorization (C4 Fix)
        && (
          (isOwner(existing().sellerId) && incoming().status in ['pending', 'booked', 'in_progress', 'shipped', 'completed', 'delivered', 'cancelled', 'refunded'])
          ||
          (isOwner(existing().buyerId) && incoming().status == existing().status)
        );
      allow delete: if false;
    }

    // ======================================================
    // 6. SELLER REVIEWS & RATINGS (NEW - TRUST & SAFETY)
    // ======================================================
    match /seller_reviews/{reviewId} {
      allow read: if isSignedIn(); // Viewable only by logged-in users
      allow create: if isVerified() && isValidId(reviewId) 
        && incoming().buyerId == request.auth.uid 
        && incoming().sellerId != request.auth.uid 
        && incoming().rating is number 
        && incoming().rating >= 1 && incoming().rating <= 5 
        && incoming().text is string && incoming().text.size() <= 2000
        && incoming().createdAt == request.time;
      allow update: if isVerified() && isValidId(reviewId) 
        && existing().buyerId == request.auth.uid 
        && incoming().buyerId == request.auth.uid 
        && incoming().sellerId == existing().sellerId 
        && incoming().rating is number 
        && incoming().rating >= 1 && incoming().rating <= 5 
        && incoming().text is string && incoming().text.size() <= 2000
        && incoming().createdAt == existing().createdAt;
      allow delete: if isVerified() && isValidId(reviewId) 
        && existing().buyerId == request.auth.uid;
    }

    // ======================================================
    // 7. CHAT MESSAGES BETWEEN TRADERS (NEW)
    // ======================================================
    match /market_messages/{messageId} {
      allow read, list: if isSignedIn() && (
        request.auth.uid in resource.data.get('participants', []) ||
        resource.data.get('senderId', '') == request.auth.uid || 
        resource.data.get('receiverId', '') == request.auth.uid || 
        resource.data.get('sellerId', '') == request.auth.uid
      );
      allow create: if isVerified() && isValidId(messageId) 
        && (incoming().get('senderId', '') == request.auth.uid || request.auth.uid in incoming().get('participants', []));
      allow update, delete: if false;
    }

    // ======================================================
    // 4. SYSTEM
    // ======================================================
    match /system/config {
      allow read: if true;
      allow write: if false; // Only via admin (not implemented here)
    }

    // ======================================================
    // 5. AI OPTIMIZATION (PILLAR 8)
    // ======================================================
    match /shared_specs/{specId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() 
        && incoming().spec is string && incoming().spec.size() <= 2000
        && incoming().createdAt == request.time;
    }

    match /users/{userId}/usage/ai {
      allow get: if isOwner(userId);
      allow write: if isOwner(userId)
        && incoming().lastAiGen == request.time;
    }

    // ======================================================
    // 8. PROTON CLIPS (TIKTOK/REELS SHORT VIDEOS)
    // ======================================================
    match /clips/{clipId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidId(clipId) 
        && incoming().creatorId == request.auth.uid
        && incoming().videoUrl is string && incoming().videoUrl.size() <= 2000
        && incoming().caption is string && incoming().caption.size() <= 500
        && incoming().creatorName is string && incoming().creatorName.size() <= 200
        && incoming().createdAt == request.time;
      allow update: if isVerified() && isValidId(clipId) && (
        // Action 1: Like/Unlike (can only alter likes array and likesCount)
        (incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'likesCount']) 
          && incoming().likes is list && incoming().likes.size() <= 100000
          && (incoming().likesCount is number || incoming().likesCount is int)) ||
        // Action 2: Edit caption/soundName by owner
        (existing().creatorId == request.auth.uid 
          && incoming().creatorId == request.auth.uid 
          && incoming().videoUrl == existing().videoUrl
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['caption', 'soundName', 'productId']))
      );
      allow delete: if isVerified() && isValidId(clipId) && existing().creatorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isVerified() && isValidId(commentId)
          && incoming().userId == request.auth.uid
          && incoming().clipId == clipId
          && incoming().text is string && incoming().text.size() <= 1000
          && incoming().createdAt == request.time;
        allow delete: if isVerified() && isValidId(commentId) 
          && (existing().userId == request.auth.uid || get(/databases/$(database)/documents/clips/$(clipId)).data.creatorId == request.auth.uid);
      }
    }
  }
}
