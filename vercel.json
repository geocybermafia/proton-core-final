{
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api?1=$1"
    },
    {
      "source": "/market-hub",
      "has": [
        {
          "type": "query",
          "key": "listingId"
        }
      ],
      "destination": "/api?path=/market-preview"
    },
    {
      "source": "/market-hub/",
      "has": [
        {
          "type": "query",
          "key": "listingId"
        }
      ],
      "destination": "/api?path=/market-preview"
    },
    {
      "source": "/market",
      "has": [
        {
          "type": "query",
          "key": "listingId"
        }
      ],
      "destination": "/api?path=/market-preview"
    },
    {
      "source": "/market/",
      "has": [
        {
          "type": "query",
          "key": "listingId"
        }
      ],
      "destination": "/api?path=/market-preview"
    },
    {
      "source": "/((?!assets/|api/|robots\\.txt|sitemap\\.xml|.*\\.[\\w]+$).*)",
      "destination": "/index.html"
    }
  ]
}
